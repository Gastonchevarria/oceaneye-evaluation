              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "properties": {
                      "value": {
                        "const": "completed"
                      }
                    }
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "results": {
                    "type": "object"
                  }
                }
              },
              "else": {
                "properties": {
                  "results": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      }
